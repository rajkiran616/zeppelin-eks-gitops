{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::REPLACE_ME_ACCOUNT_ID:oidc-provider/oidc.eks.REPLACE_ME_REGION.amazonaws.com/id/REPLACE_ME_OIDC_ID"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "oidc.eks.REPLACE_ME_REGION.amazonaws.com/id/REPLACE_ME_OIDC_ID:aud": "sts.amazonaws.com",
          "oidc.eks.REPLACE_ME_REGION.amazonaws.com/id/REPLACE_ME_OIDC_ID:sub": "system:serviceaccount:REPLACE_ME_NAMESPACE:REPLACE_ME_SA_NAME"
        }
      }
    }
  ]
}
