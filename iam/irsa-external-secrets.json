{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SecretsManagerRead",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "secretsmanager:ListSecretVersionIds"
      ],
      "Resource": [
        "arn:aws:secretsmanager:REPLACE_ME_REGION:REPLACE_ME_ACCOUNT_ID:secret:zeppelin/*"
      ]
    },
    {
      "Sid": "KmsDecryptIfNeeded",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": [
        "arn:aws:kms:REPLACE_ME_REGION:REPLACE_ME_ACCOUNT_ID:key/REPLACE_ME_KMS_KEY_ID"
      ],
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.REPLACE_ME_REGION.amazonaws.com"
        }
      }
    }
  ]
}
